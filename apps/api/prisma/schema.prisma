generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                    String                 @id @default(cuid())
  provider              String
  providerDbId          String
  name                  String
  alias                 String
  createdAt             DateTime               @default(now())
  users                 User[]
  connections           Connection[]
  roles                 Role[]
  chatSessions          ChatSession[]
  auditLogs             AuditLog[]
  driveJobs             DriveJob[]
  subscriptions         Subscription[]
  payments              Payment[]
  waAccount             WaAccount?
  waBalance             WaBalance?
  waTopups              WaTopup[]
  waMessages            WaMessageLog[]
  accurateWebhookEvents AccurateWebhookEvent[]
  storefront            Storefront?
  storefrontProducts    StorefrontProduct[]

  @@unique([provider, providerDbId])
}

model Role {
  id          String           @id @default(cuid())
  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  tenantId    String
  key         String
  name        String
  permissions RolePermission[]
  users       User[]

  @@unique([tenantId, key])
}

model RolePermission {
  id            String @id @default(cuid())
  role          Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId        String
  permissionKey String

  @@unique([roleId, permissionKey])
}

model User {
  id             String        @id @default(cuid())
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  tenantId       String
  providerUserId String
  email          String
  name           String
  phone          String        @default("")
  passwordHash   String        @default("")
  role           Role          @relation(fields: [roleId], references: [id])
  roleId         String
  createdAt      DateTime      @default(now())
  sessions       Session[]
  chatSessions   ChatSession[]

  @@unique([tenantId, providerUserId])
}

model Connection {
  id              String   @id @default(cuid())
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  tenantId        String
  provider        String
  accessTokenEnc  String
  refreshTokenEnc String
  expiresAt       DateTime
  host            String   @default("")
  session         String   @default("")
  status          String   @default("connected")
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, provider])
}

// Akun operator PLATFORM — tabel terpisah dari akun Accurate (perusahaan pelanggan).
// Platform tidak menumpang tenant/perusahaan mana pun.
model PlatformUser {
  id           String            @id @default(cuid())
  email        String            @unique
  name         String
  passwordHash String            @default("")
  createdAt    DateTime          @default(now())
  sessions     PlatformSession[]
}

model PlatformSession {
  id             String       @id
  platformUser   PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)
  platformUserId String
  expiresAt      DateTime
  createdAt      DateTime     @default(now())

  @@index([platformUserId])
  @@index([expiresAt])
}

model Session {
  id        String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@index([userId])
}

model AppSetting {
  key   String @id
  value String
}

model ChatSession {
  id        String        @id @default(cuid())
  tenant    Tenant        @relation(fields: [tenantId], references: [id])
  tenantId  String
  user      User          @relation(fields: [userId], references: [id])
  userId    String
  title     String        @default("Percakapan baru")
  createdAt DateTime      @default(now())
  messages  ChatMessage[]
}

model ChatMessage {
  id        String      @id @default(cuid())
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  role      String
  content   String
  toolTrace String      @default("[]")
  createdAt DateTime    @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  tenantId  String
  userId    String
  action    String
  detail    String   @default("{}")
  createdAt DateTime @default(now())
}

model DriveJob {
  id         String           @id @default(cuid())
  tenant     Tenant           @relation(fields: [tenantId], references: [id])
  tenantId   String
  userId     String
  folderId   String
  folderName String           @default("")
  status     String           @default("planned") // planned|running|done|cancelled|failed|undone
  planJson   String           @default("[]")
  resultJson String           @default("{}")
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  logs       DriveActionLog[]
}

model DriveActionLog {
  id         String   @id @default(cuid())
  job        DriveJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId      String
  fileId     String
  fileName   String   @default("")
  action     String // create_folder|rename|move
  fromParent String   @default("")
  toParent   String   @default("")
  status     String   @default("ok") // ok|failed|skipped
  error      String   @default("")
  createdAt  DateTime @default(now())
}

model Subscription {
  id        String    @id @default(cuid())
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  tenantId  String
  plan      String    @default("free") // free|pro|enterprise
  status    String    @default("active") // active|expired|cancelled
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([tenantId])
}

model Payment {
  id              String   @id @default(cuid())
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  tenantId        String
  orderId         String   @unique
  amount          Int // dalam Rupiah
  status          String   @default("pending") // pending|settlement|deny|cancel|expire
  paymentMethod   String   @default("")
  transactionTime DateTime @default(now())
  fraudStatus     String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
  @@index([orderId])
}

model WaAccount {
  id            String   @id @default(cuid())
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  tenantId      String
  wabaId        String   @default("")
  phoneNumberId String   @default("")
  displayName   String   @default("")
  tokenEnc      String   @default("")
  provider      String   @default("meta") // meta|waserver
  status        String   @default("pending") // pending|connected|error
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId])
}

model WaBalance {
  tenantId  String   @id
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  amount    Int      @default(0) // kredit pesan
  updatedAt DateTime @updatedAt
}

model WaTopup {
  id            String   @id @default(cuid())
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  tenantId      String
  orderId       String   @unique
  amount        Int // Rupiah
  credits       Int // amount / 200
  status        String   @default("pending") // pending|settlement|deny|cancel|expire
  paymentMethod String   @default("")
  providerRef   String   @default("") // referensi provider pembayaran (Midtrans referenceNo)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
  @@index([orderId])
}

model WaMessageLog {
  id               String   @id @default(cuid())
  tenant           Tenant   @relation(fields: [tenantId], references: [id])
  tenantId         String
  /// lawan bicara: nomor tujuan bila keluar, nomor pengirim bila masuk
  to               String
  body             String
  status           String // sent|failed|received|queued
  direction        String   @default("out") // out|in
  error            String   @default("")
  costCredits      Int      @default(1)
  /// tautan ke outbox waserver — dipakai utk menyinkronkan status kirim
  waserverOutboxId Int?
  createdAt        DateTime @default(now())

  @@index([tenantId])
  @@index([waserverOutboxId])
}

// ── Storefront publik per perusahaan (satu tenant = satu database Accurate) ──
model Storefront {
  id               String    @id @default(cuid())
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId         String    @unique
  slug             String    @unique
  /// product = katalog + checkout order; service = katalog + CTA WhatsApp
  mode             String    @default("product")
  /// product-1..3 atau service-1..3
  template         String    @default("product-1")
  /// tema warna independen dari layout template
  theme            String    @default("warm")
  /// banner hero (URL upload)
  bannerUrl        String    @default("")
  /// logo perusahaan di header storefront (URL upload)
  logoUrl          String    @default("")
  tagline          String    @default("")
  description      String    @default("")
  /// nomor WhatsApp CTA; kosong = pakai nomor pemilik di pengaturan WA
  whatsapp         String    @default("")
  active           Boolean   @default(true)
  productsSyncedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([active])
}

model StorefrontProduct {
  id          String   @id @default(cuid())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId    String
  itemNo      String
  /// nama dari Accurate (cache)
  name        String   @default("")
  /// judul tampilan storefront (boleh beda dari Accurate)
  title       String   @default("")
  description String   @default("")
  imageUrl    String   @default("")
  /// JSON array URL gambar tambahan (termasuk cover di index 0)
  images      String   @default("[]")
  category    String   @default("")
  unit        String   @default("")
  /// cache harga jual & stok dari Accurate saat sinkron
  price       Float?
  stock       Float?
  active      Boolean  @default(true)
  featured    Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, itemNo])
  @@index([tenantId, active, sortOrder])
}

// Provider AI (OpenAI-compatible) — dikelola admin platform via halaman /ai
model AiProvider {
  id        String            @id @default(cuid())
  name      String
  baseUrl   String
  apiKey    String // plaintext, konsisten dgn AppSetting
  isActive  Boolean           @default(false)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  models    AiProviderModel[]
}

// Model tercentang milik satu provider — "tercentang" = baris ada
model AiProviderModel {
  id           String     @id @default(cuid())
  providerId   String
  provider     AiProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  name         String
  rank         Int        @default(0) // urutan percobaan (0 = utama)
  failureCount Int        @default(0)
  lastError    String     @default("")
  lastOkAt     DateTime?
  lastFailAt   DateTime?

  @@unique([providerId, name])
  @@index([providerId, rank])
}

// Webhook masuk dari Accurate Online (73 jenis event sesuai docs-modules; payload disimpan mentah)
model AccurateWebhookEvent {
  id        String   @id @default(cuid())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  tenantId  String
  event     String
  dbId      String   @default("")
  payload   String   @default("{}")
  createdAt DateTime @default(now())

  @@index([tenantId, event, createdAt])
}

// Pemakaian LLM per tenant per hari (estimasi token — utk kuota & analytics)
model LlmUsage {
  id               String   @id @default(cuid())
  tenantId         String
  day              String // yyyy-mm-dd (UTC)
  kind             String // chat|voice|router|doc
  model            String   @default("")
  calls            Int      @default(0)
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  updatedAt        DateTime @updatedAt

  @@unique([tenantId, day, kind, model])
  @@index([tenantId, day])
}

// Snapshot metrik harian hasil sync Accurate (penjualan/pembelian per tanggal)
model DailyMetric {
  id            String   @id @default(cuid())
  tenantId      String
  date          String // yyyy-mm-dd
  salesTotal    Float    @default(0)
  salesCount    Int      @default(0)
  purchaseTotal Float    @default(0)
  purchaseCount Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, date])
  @@index([tenantId, date])
}

// Indeks isi file Google Drive (nama + teks PDF) — pencarian nama ATAU isi
model DriveIndex {
  id           String   @id @default(cuid())
  tenantId     String
  fileId       String
  name         String
  folder       String   @default("")
  mimeType     String   @default("")
  text         String   @default("")
  modifiedTime String   @default("")
  indexedAt    DateTime @default(now())

  @@unique([tenantId, fileId])
  @@index([tenantId, name])
}

// ── Billing AI per member (saldo rupiah, harga basis OpenRouter + markup) ──
model AiWallet {
  userId    String   @id
  tenantId  String
  /// saldo dalam rupiah (integer)
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model AiLedger {
  id               String   @id @default(cuid())
  userId           String
  tenantId         String
  /// bonus|topup|usage|adjust|refund
  kind             String
  /// + kredit / − tagihan (rupiah)
  amount           Int
  /// modal (rupiah) utk kind=usage — dasar laporan margin
  cost             Int      @default(0)
  model            String   @default("")
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  refId            String   @default("")
  meta             String   @default("")
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
  @@index([tenantId, createdAt])
}

model AiTopup {
  id            String   @id @default(cuid())
  orderId       String   @unique
  userId        String
  tenantId      String
  /// rupiah dibayar (termasuk biaya admin)
  amount        Int
  /// rupiah masuk saldo
  credits       Int
  status        String   @default("pending") // pending|settlement|cancel|expire
  paymentMethod String   @default("qris")
  providerRef   String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([tenantId])
}

model AiModelPrice {
  id             String   @id @default(cuid())
  model          String   @unique
  openrouterId   String   @default("")
  inputUsdPer1M  Float    @default(0.3)
  outputUsdPer1M Float    @default(1.2)
  markup         Float    @default(1.5)
  source         String   @default("manual") // openrouter|manual
  updatedAt      DateTime @updatedAt
}

// ── Insight pasar (berita eksternal) ────────────────────────────────────────
model NewsSource {
  id        String   @id @default(cuid())
  industry  String // kunci industri atau "umum"
  topic     String // regulasi|harga|tren|event|makro|industri|umum
  query     String   @unique // kata kunci pencarian (Google News RSS)
  weight    Float    @default(1)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([industry])
}

model NewsItem {
  id           String    @id @default(cuid())
  url          String    @unique
  title        String
  snippet      String    @default("")
  sourceName   String    @default("")
  sourceDomain String    @default("")
  publishedAt  DateTime?
  fetchedAt    DateTime  @default(now())
  topic        String    @default("umum")
  industries   String    @default("") // dipisah koma
  hash         String    @unique

  @@index([publishedAt])
  @@index([topic])
}

model TenantIndustry {
  id        String   @id @default(cuid())
  tenantId  String
  industry  String
  weight    Float    @default(1)
  evidence  Json?
  updatedAt DateTime @updatedAt

  @@unique([tenantId, industry])
  @@index([tenantId])
}

model NewsDigest {
  id          String   @id @default(cuid())
  tenantId    String
  date        String // yyyy-mm-dd (WIB)
  payload     Json
  generatedAt DateTime @default(now())

  @@unique([tenantId, date])
  @@index([tenantId, date])
}

model NewsAskLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  question  String
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

// Sinyal harga pasar/pesaing untuk produk yang dijual tenant (dari berita/marketplace terindeks)
model PriceSignal {
  id          String    @id @default(cuid())
  tenantId    String
  productName String
  ownPrice    Float?
  marketPrice Float
  marketMin   Float?
  marketMax   Float?
  title       String
  snippet     String    @default("")
  sourceName  String    @default("")
  sourceUrl   String
  publishedAt DateTime?
  fetchedAt   DateTime  @default(now())

  @@unique([tenantId, sourceUrl])
  @@index([tenantId, fetchedAt])
  @@index([tenantId, productName])
}

// Harga produk yang sama di berbagai marketplace (dari price API, mis. Google Shopping/SerpAPI)
model MarketplacePrice {
  id          String   @id @default(cuid())
  tenantId    String
  productName String
  marketplace String
  price       Float
  title       String   @default("")
  link        String   @default("")
  fetchedAt   DateTime @default(now())

  @@unique([tenantId, productName, marketplace, link])
  @@index([tenantId, fetchedAt])
  @@index([tenantId, productName])
}

// ── Wallet Penjualan: saldo hasil penjualan per tenant (rupiah) ──
model SalesWallet {
  tenantId  String   @id
  balance   Int      @default(0) // saldo hasil penjualan (integer rupiah)
  updatedAt DateTime @updatedAt
}

// Ledger pergerakan wallet penjualan: sale (masuk) / withdraw (keluar) / adjust
model SalesWalletTx {
  id        String   @id @default(cuid())
  tenantId  String
  kind      String // sale|withdraw|adjust|refund
  amount    Int // positif masuk, negatif keluar
  orderId   String   @default("")
  note      String   @default("")
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

// Permintaan penarikan hasil penjualan
model SalesWithdrawal {
  id          String   @id @default(cuid())
  tenantId    String
  amount      Int
  status      String   @default("pending") // pending|approved|paid|rejected
  bankName    String   @default("")
  bankNo      String   @default("")
  accountName String   @default("")
  note        String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, createdAt])
}

// Rekening penarikan tersimpan per tenant — tervalidasi via Brick BAV sebelum disimpan
model SalesBankAccount {
  id            String   @id @default(cuid())
  tenantId      String
  bankShortCode String // kode bank Brick (mis. BCA, MANDIRI)
  bankName      String
  accountNo     String
  accountName   String // nama pemilik dari hasil validasi Brick
  activityId    String   @default("") // id validasi Brick terakhir
  createdAt     DateTime @default(now())

  @@unique([tenantId, bankShortCode, accountNo])
  @@index([tenantId])
}
