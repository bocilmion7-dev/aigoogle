generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id           String       @id @default(cuid())
  provider     String
  providerDbId String
  name         String
  alias        String
  createdAt    DateTime     @default(now())
  users        User[]
  connections  Connection[]
  roles        Role[]
  chatSessions ChatSession[]
  auditLogs    AuditLog[]
  driveJobs    DriveJob[]
  subscriptions Subscription[]
  payments     Payment[]
  waAccount    WaAccount?
  waBalance    WaBalance?
  waTopups     WaTopup[]
  waMessages   WaMessageLog[]
  accurateWebhookEvents AccurateWebhookEvent[]
  @@unique([provider, providerDbId])
}

model Role {
  id          String           @id @default(cuid())
  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  tenantId    String
  key         String
  name        String
  permissions RolePermission[]
  users       User[]
  @@unique([tenantId, key])
}

model RolePermission {
  id            String @id @default(cuid())
  role          Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId        String
  permissionKey String
  @@unique([roleId, permissionKey])
}

model User {
  id             String   @id @default(cuid())
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  tenantId       String
  providerUserId String
  email          String
  name           String
  phone          String   @default("")
  passwordHash   String   @default("")
  role           Role     @relation(fields: [roleId], references: [id])
  roleId         String
  createdAt      DateTime @default(now())
  sessions       Session[]
  chatSessions   ChatSession[]
  @@unique([tenantId, providerUserId])
}

model Connection {
  id              String   @id @default(cuid())
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  tenantId        String
  provider        String
  accessTokenEnc  String
  refreshTokenEnc String
  expiresAt       DateTime
  host            String     @default("")
  session         String     @default("")
  status          String     @default("connected")
  updatedAt       DateTime @updatedAt
  @@unique([tenantId, provider])
}

// Akun operator PLATFORM — tabel terpisah dari akun Accurate (perusahaan pelanggan).
// Platform tidak menumpang tenant/perusahaan mana pun.
model PlatformUser {
  id           String            @id @default(cuid())
  email        String            @unique
  name         String
  passwordHash String            @default("")
  createdAt    DateTime          @default(now())
  sessions     PlatformSession[]
}

model PlatformSession {
  id             String       @id
  platformUser   PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)
  platformUserId String
  expiresAt      DateTime
  createdAt      DateTime     @default(now())

  @@index([platformUserId])
  @@index([expiresAt])
}

model Session {
  id        String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@index([userId])
}

model AppSetting {
  key   String @id
  value String
}

model ChatSession {
  id        String        @id @default(cuid())
  tenant    Tenant        @relation(fields: [tenantId], references: [id])
  tenantId  String
  user      User          @relation(fields: [userId], references: [id])
  userId    String
  title     String        @default("Percakapan baru")
  createdAt DateTime      @default(now())
  messages  ChatMessage[]
}

model ChatMessage {
  id        String      @id @default(cuid())
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  role      String
  content   String
  toolTrace String      @default("[]")
  createdAt DateTime    @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  tenantId  String
  userId    String
  action    String
  detail    String   @default("{}")
  createdAt DateTime @default(now())
}

model DriveJob {
  id         String            @id @default(cuid())
  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  tenantId   String
  userId     String
  folderId   String
  folderName String            @default("")
  status     String            @default("planned") // planned|running|done|cancelled|failed|undone
  planJson   String            @default("[]")
  resultJson String            @default("{}")
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  logs       DriveActionLog[]
}

model DriveActionLog {
  id         String   @id @default(cuid())
  job        DriveJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId      String
  fileId     String
  fileName   String   @default("")
  action     String   // create_folder|rename|move
  fromParent String   @default("")
  toParent   String   @default("")
  status     String   @default("ok") // ok|failed|skipped
  error      String   @default("")
  createdAt  DateTime @default(now())
}

model Subscription {
  id        String    @id @default(cuid())
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  tenantId  String
  plan      String    @default("free") // free|pro|enterprise
  status    String    @default("active") // active|expired|cancelled
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  @@index([tenantId])
}

model Payment {
  id                String   @id @default(cuid())
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  tenantId          String
  orderId           String   @unique
  amount            Int      // dalam Rupiah
  status            String   @default("pending") // pending|settlement|deny|cancel|expire
  paymentMethod     String   @default("")
  transactionTime   DateTime @default(now())
  fraudStatus       String   @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  @@index([tenantId])
  @@index([orderId])
}

model WaAccount {
  id            String   @id @default(cuid())
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  tenantId      String
  wabaId        String   @default("")
  phoneNumberId String   @default("")
  displayName   String   @default("")
  tokenEnc      String   @default("")
  provider      String   @default("meta") // meta|d360
  status        String   @default("pending") // pending|connected|error
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@unique([tenantId])
}

model WaBalance {
  tenantId String @id
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  amount   Int    @default(0) // kredit pesan
  updatedAt DateTime @updatedAt
}

model WaTopup {
  id            String   @id @default(cuid())
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  tenantId      String
  orderId       String   @unique
  amount        Int      // Rupiah
  credits       Int      // amount / 200
  status        String   @default("pending") // pending|settlement|deny|cancel|expire
  paymentMethod String   @default("")
  providerRef   String   @default("") // contractId Winpay / referensi provider pembayaran
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([tenantId])
  @@index([orderId])
}

model WaMessageLog {
  id          String   @id @default(cuid())
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  tenantId    String
  to          String
  body        String
  status      String   // sent|failed
  error       String   @default("")
  costCredits Int      @default(1)
  createdAt   DateTime @default(now())
  @@index([tenantId])
}

// Pool model Gemini — daftar model "live" dari API (di-refresh saat SEMUA model gagal)
model GeminiModel {
  id           String    @id // "generate:gemini-x-flash"
  action       String // generate | tts | stt
  name         String
  rank         Int       @default(0) // urutan percobaan (0 = utama)
  failureCount Int       @default(0) // gagal berutun → menunggu refresh live
  lastError    String    @default("")
  lastOkAt     DateTime?
  lastFailAt   DateTime?
  syncedAt     DateTime  @default(now())
  @@index([action, rank])
}

// Webhook masuk dari Accurate Online (73 jenis event sesuai docs-modules; payload disimpan mentah)
model AccurateWebhookEvent {
  id        String   @id @default(cuid())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  tenantId  String
  event     String
  dbId      String   @default("")
  payload   String   @default("{}")
  createdAt DateTime @default(now())

  @@index([tenantId, event, createdAt])
}
